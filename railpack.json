{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.12",
    "node": "24"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "python3 -m pip install --disable-pip-version-check --no-cache-dir --target /app/.tiktok-python -r requirements-tiktok.txt",
        "PYTHONPATH=/app/.tiktok-python python3 -c 'import yt_dlp' && php -l /app/app/Http/Controllers/YouTubeDownloaderController.php && python3 -m py_compile /app/scripts/youtube_downloader.py"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "...",
      "ffmpeg",
      "chromium"
    ],
    "variables": {
      "PYTHONPATH": "/app/.tiktok-python",
      "CHROMIUM_PATH": "/usr/bin/chromium"
    }
  }
}
